    <!-- 1. User Setup Modal (PROFILE SETUP) -->
    <!-- ID changed to clearly indicate Setup context -->
    <div id="userDetailsModal" class="fixed inset-0 bg-emerald-100/40 backdrop-blur-sm z-[300] flex items-center justify-center hidden">
        <div class="cute-card p-5 max-w-sm w-full mx-4 animate-in fade-in zoom-in duration-300 border border-emerald-100 max-h-[95vh] overflow-y-auto">
            <div class="text-center mb-3">
                <div class="inline-block p-2 bg-emerald-100 rounded-full mb-1">
                    <i class="fas fa-leaf text-emerald-500 text-lg"></i>
                </div>
                <h2 class="text-lg font-bold text-emerald-600">Welcome ✨</h2>
                <p class="text-gray-500 text-xs italic">Customize your profile.</p>
            </div>
            
            <div class="flex flex-col items-center mb-3">
                <div class="relative group cursor-pointer z-10" onclick="document.getElementById('profilePicInput').click()">
                    <img id="previewProfilePic" class="w-16 h-16 rounded-full object-cover border-4 border-emerald-50 shadow-inner" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Avatar">
                    <div class="absolute bottom-0 right-0 bg-white shadow-lg rounded-full p-1.5 border border-emerald-100 z-10">
                        <i class="fas fa-camera text-emerald-400 text-[10px]"></i>
                    </div>
                    <button onclick="event.stopPropagation(); initManualCrop();" class="absolute bottom-0 -left-1 bg-white shadow-md rounded-full w-6 h-6 flex items-center justify-center cursor-pointer hover:bg-emerald-50 transition border border-emerald-100 z-20" title="Adjust Photo">
                        <i class="fas fa-crop text-emerald-500 text-[10px]"></i>
                    </button>
                </div>
                <input type="file" id="profilePicInput" accept="image/*" class="hidden">
            </div>

            <div class="space-y-2">
                <input type="text" id="userNameInput" class="w-full px-4 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 focus:ring-2 focus:ring-emerald-200 outline-none text-emerald-700 text-sm" placeholder="Your Name" oninput="this.value = this.value.replace(/\b\w/g, c => c.toUpperCase())">
                <div class="grid grid-cols-2 gap-2">
                    <input type="text" id="professionInput" class="w-full px-3 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 focus:ring-2 focus:ring-emerald-200 outline-none text-emerald-700 text-xs" placeholder="Profession">
                    <input type="tel" id="mobileInput" class="w-full px-3 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 focus:ring-2 focus:ring-emerald-200 outline-none text-emerald-700 text-xs" placeholder="Mobile No.">
                </div>
                
                <!-- Setup Toggle (RENAMED ID for conflict avoidance) -->
                <div class="flex items-center justify-between mt-1 px-1">
                    <label class="text-xs font-bold text-emerald-700 flex items-center gap-1">
                        <i class="fas fa-users text-emerald-500"></i> Show 'Follow Me'
                    </label>
                    <label class="relative inline-flex items-center cursor-pointer">
                        <!-- Renamed ID: setupSocialsToggle -->
                        <input type="checkbox" id="setupSocialsToggle" class="sr-only peer" checked>
                        <div class="w-9 h-5 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-emerald-500"></div>
                    </label>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div class="relative">
                        <i class="fab fa-instagram absolute left-3 top-2.5 text-emerald-400 text-xs"></i>
                        <input type="text" id="instaInput" class="w-full pl-8 pr-2 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 outline-none text-emerald-700 text-xs" placeholder="@insta">
                    </div>
                    <div class="relative">
                        <i class="fab fa-twitter absolute left-3 top-2.5 text-emerald-400 text-xs"></i>
                        <input type="text" id="twitterInput" class="w-full pl-8 pr-2 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 outline-none text-emerald-700 text-xs" placeholder="@twitter">
                    </div>
                    <div class="col-span-2 relative">
                        <i class="fab fa-facebook-f absolute left-3 top-2.5 text-emerald-400 text-xs"></i>
                        <input type="text" id="fbInput" class="w-full pl-8 pr-2 py-2 rounded-xl bg-emerald-50/50 border border-emerald-100 outline-none text-emerald-700 text-xs" placeholder="Facebook ID/Name">
                    </div>
                </div>

                <button onclick="saveUserSetup()" class="w-full bg-gradient-to-r from-emerald-500 to-teal-500 text-white py-2.5 rounded-xl font-bold shadow-lg shadow-emerald-100 hover:scale-[1.02] active:scale-95 transition-all text-sm mt-1">Design Shuru Karein</button>
            </div>
        </div>
    </div>
