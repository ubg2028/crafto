    <!-- 4. Editor Modal (EDITING CONTEXT) -->
    <div id="modal" class="fixed inset-0 bg-emerald-900/40 backdrop-blur-md hidden z-[100] flex items-center justify-center p-4">
        <div class="relative w-full max-w-md max-h-[90vh] overflow-y-auto transition-all duration-300" id="modal-content-area" style="border-radius: 0;">
            
            <button onclick="closeModal()" class="sticky top-0 left-0 z-[200] bg-white text-emerald-500 p-2 rounded-full shadow-lg transition active:scale-90 mb-4 border border-emerald-100">
                <i class="fas fa-times w-5 h-5 flex items-center justify-center"></i>
            </button>

            <!-- Panels -->
            <div id="fontListPanel" class="hidden overlay-panel-top glass-panel-aesthetic p-4 rounded-3xl shadow-2xl animate-in slide-in-from-top duration-300">
                <h4 class="text-[10px] font-bold mb-3 flex justify-between uppercase tracking-wider text-emerald-600">Typography <span onclick="togglePanel('fontListPanel')" class="text-emerald-300 cursor-pointer italic">✕</span></h4>
                <div class="flex flex-col gap-1 max-h-48 overflow-y-auto pr-2 custom-scroll">
                    <button onclick="selectFont('font-poppins')" class="w-full text-left p-3 text-sm bg-emerald-50 border border-emerald-100 rounded-xl hover:bg-emerald-100 transition font-poppins mb-1 text-emerald-700">Poppins</button>
                    <button onclick="selectFont('font-playfair')" class="w-full text-left p-3 text-sm bg-emerald-50 border border-emerald-100 rounded-xl hover:bg-emerald-100 transition font-playfair mb-1 text-emerald-700">Playfair</button>
                    <button onclick="selectFont('font-meow-script')" class="w-full text-left p-3 text-sm bg-emerald-50 border border-emerald-100 rounded-xl hover:bg-emerald-100 transition font-meow-script text-lg mb-1 text-teal-600">Meow</button>
                    <button onclick="selectFont('font-pacifico')" class="w-full text-left p-3 text-sm bg-emerald-50 border border-emerald-100 rounded-xl hover:bg-emerald-100 transition font-pacifico mb-1 text-emerald-700">Pacifico</button>
                    <button onclick="selectFont('font-quicksand')" class="w-full text-left p-3 text-sm bg-emerald-50 border border-emerald-100 rounded-xl hover:bg-emerald-100 transition font-quicksand mb-1 text-emerald-700">Quicksand</button>
                </div>
            </div>

            <div id="alignmentPanel" class="hidden overlay-panel-top glass-panel-aesthetic p-4 rounded-3xl shadow-2xl animate-in slide-in-from-top duration-300">
                <h4 class="text-[10px] font-bold mb-3 flex justify-between uppercase tracking-wider text-emerald-600">Alignment <span onclick="togglePanel('alignmentPanel')" class="text-emerald-300 cursor-pointer italic">✕</span></h4>
                <div class="grid grid-cols-3 gap-2">
                    <button onclick="setTheme('left')" class="p-3 bg-emerald-50 border border-emerald-100 rounded-2xl shadow-sm hover:bg-emerald-100 transition flex flex-col items-center gap-1">
                        <i class="fas fa-align-left text-emerald-500 text-xs"></i>
                        <span class="text-[9px] font-bold uppercase text-emerald-400">Left</span>
                    </button>
                    <button onclick="setTheme('center')" class="p-3 bg-emerald-50 border border-emerald-100 rounded-2xl shadow-sm hover:bg-emerald-100 transition flex flex-col items-center gap-1">
                        <i class="fas fa-align-center text-emerald-500 text-xs"></i>
                        <span class="text-[9px] font-bold uppercase text-emerald-400">Center</span>
                    </button>
                    <button onclick="setTheme('right')" class="p-3 bg-emerald-50 border border-emerald-100 rounded-2xl shadow-sm hover:bg-emerald-100 transition flex flex-col items-center gap-1">
                        <i class="fas fa-align-right text-emerald-500 text-xs"></i>
                        <span class="text-[9px] font-bold uppercase text-emerald-400">Right</span>
                    </button>
                </div>
            </div>

            <div id="adjustmentsPanel" class="hidden overlay-panel-top glass-panel-aesthetic p-4 rounded-3xl shadow-2xl animate-in slide-in-from-top duration-300">
                <h4 class="text-[10px] font-bold mb-3 flex justify-between uppercase tracking-wider text-emerald-600">Adjustments <span onclick="togglePanel('adjustmentsPanel')" class="text-emerald-300 cursor-pointer italic">✕</span></h4>
                
                <!-- Profile Size Slider -->
                <div class="px-2 mb-3">
                    <div class="flex justify-between text-[9px] text-emerald-600 font-bold mb-1">
                        <span>Profile Size</span>
                        <span id="sizeValueDisplay">80px</span>
                    </div>
                    <input type="range" id="profileSizeSlider" min="40" max="120" value="80" oninput="updateProfileSize(this.value)" class="w-full cursor-pointer">
                </div>

                <!-- Card Opacity Slider -->
                <div class="px-2">
                    <div class="flex justify-between text-[9px] text-emerald-600 font-bold mb-1">
                        <span>Card Darkness</span>
                        <span id="opacityValueDisplay">80%</span>
                    </div>
                    <input type="range" id="cardOpacitySlider" min="0" max="100" value="80" oninput="updateCardOpacity(this.value)" class="w-full cursor-pointer">
                </div>
            </div>

            <!-- Capture Area -->
            <div id="captureArea" class="relative shadow-2xl">
                <div class="relative">
                    <!-- CHANGED: Removed aspect-ratio and object-cover to prevent cropping -->
                    <img id="modalImage" class="w-full h-auto block" src="" crossorigin="anonymous">
                    
                    <!-- Fixed Logo on TOP RIGHT (Always) -->
                    <img id="userLogoImg" class="absolute top-2 right-2 w-12 h-12 object-contain drop-shadow-xl z-30 transition-all duration-300" src="" crossorigin="anonymous" alt="Logo">
                    
                    <!-- Fixed Watermark on BOTTOM LEFT (Always) -->
                    <!-- UPDATED: Background on parent div, text inside -->
                    <div class="absolute bottom-2 left-2 z-30 pointer-events-none bg-black/40 px-3 py-1 rounded-full backdrop-blur-[1px]">
                        <span class="text-[7px] text-white font-quicksand font-bold tracking-[0.3em] uppercase drop-shadow-md">Generated By Mysite.com</span>
                    </div>
                </div>

                <!-- Profile Overlay (User Card) -->
                <div id="profileOverlay" class="poster-overlay-container theme-left" style="background: linear-gradient(to top, rgba(0,0,0,0.8), rgba(0,0,0,0.6));">
                    <div class="profile-group">
                        <div class="profile-pic-container relative cursor-pointer group" onclick="document.getElementById('updateProfilePicInput').click()" title="Change Picture">
                            <img id="modalProfilePic" class="w-16 h-16 rounded-full border-4 border-white/30 shadow-xl object-cover" style="width: 80px; height: 80px;">
                            <div class="capture-hide absolute inset-0 flex items-center justify-center bg-black/30 rounded-full opacity-0 group-hover:opacity-100 transition-opacity">
                                <i class="fas fa-pen text-white text-xs"></i>
                            </div>
                            <!-- UPDATED: Smaller crop button -->
                            <button onclick="event.stopPropagation(); initManualCrop();" class="capture-hide absolute bottom-0 -left-1 bg-white shadow-md rounded-full w-6 h-6 flex items-center justify-center cursor-pointer hover:bg-emerald-50 transition border border-emerald-100 z-20" title="Adjust Photo">
                                <i class="fas fa-crop text-emerald-500 text-[10px]"></i>
                            </button>
                        </div>
                        
                        <div class="profile-text transition-all duration-300 flex flex-col">
                            <!-- Added mb-1 for spacing below name -->
                            <h3 class="modal-profile-name font-bold text-xl drop-shadow-md cursor-pointer mb-1" id="modalProfileName" onclick="editProfileText('modalProfileName')">Name</h3>
                            <div class="details-block">
                                <div class="info-row cursor-pointer" onclick="editProfileText('modalProfileExtra')">
                                    <i class="fas fa-briefcase text-xs fw-icon"></i>
                                    <p id="modalProfileExtra" class="text-xs">Web Developer</p>
                                </div>
                                <div class="info-row contact-wrapper cursor-pointer hover:opacity-100 transition" onclick="editProfileText('modalProfileContact')">
                                    <i class="fab fa-whatsapp text-sm fw-icon"></i>
                                    <p id="modalProfileContact" class="text-[10px]">9876543210</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="social-media-section social-group cursor-pointer hover:opacity-80 transition" onclick="editSocials()">
                        <p class="text-[8px] font-bold opacity-80 uppercase tracking-widest mb-0.5 flex items-center gap-1">
                            Follow Me <i class="fas fa-pen text-[8px] opacity-50 capture-hide"></i>
                        </p>
                        <div id="socialsContainer" class="social-inner-block flex flex-col gap-0.5 text-[10px] font-medium opacity-90">
                            <!-- JS will populate -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="h-40 w-full"></div>

            <!-- Text Edit UI -->
            <div id="textEditPanel" class="hidden absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 glass-panel-aesthetic p-6 rounded-3xl z-[250] w-64 shadow-2xl">
                <input type="text" id="textEditInput" class="w-full p-3 rounded-xl bg-white border border-emerald-100 outline-none mb-3 text-sm shadow-inner text-emerald-600" placeholder="Enter text...">
                <button onclick="saveProfileText()" class="w-full bg-emerald-500 text-white py-2 rounded-xl text-sm font-bold shadow-md shadow-emerald-100">Update</button>
            </div>

            <!-- Socials Edit UI -->
            <div id="socialsEditPanel" class="hidden absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 glass-panel-aesthetic p-6 rounded-3xl z-[250] w-72 shadow-2xl">
                <!-- ... existing social edit panel code ... -->
                <div class="flex justify-between items-center mb-3">
                    <h4 class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Socials</h4>
                    <!-- Renamed ID: editorSocialsToggle -->
                    <button id="editorSocialsToggle" onclick="toggleEditorSocials()" class="text-emerald-500 hover:text-emerald-700 transition" title="Toggle Section">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
                
                <div class="space-y-2 mb-3">
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1">
                            <i class="fab fa-instagram absolute left-3 top-2.5 text-emerald-400 text-xs"></i>
                            <input type="text" id="editInstaInput" class="w-full pl-8 pr-3 py-2 rounded-xl bg-white border border-emerald-100 outline-none text-emerald-700 text-xs" placeholder="@insta">
                        </div>
                        <!-- Updated onclick to specific Editor function -->
                        <button onclick="toggleEditorPlatform('insta')" id="btn-insta" class="w-8 h-8 flex items-center justify-center bg-white rounded-xl border border-emerald-100 text-emerald-400 hover:bg-emerald-50 transition">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1">
                            <i class="fab fa-twitter absolute left-3 top-2.5 text-emerald-400 text-xs"></i>
                            <input type="text" id="editTwitterInput" class="w-full pl-8 pr-3 py-2 rounded-xl bg-white border border-emerald-100 outline-none text-emerald-700 text-xs" placeholder="@twitter">
                        </div>
                        <button onclick="toggleEditorPlatform('twitter')" id="btn-twitter" class="w-8 h-8 flex items-center justify-center bg-white rounded-xl border border-emerald-100 text-emerald-400 hover:bg-emerald-50 transition">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="relative flex-1">
                            <i class="fab fa-facebook-f absolute left-3 top-2.5 text-emerald-400 text-xs"></i>
                            <input type="text" id="editFbInput" class="w-full pl-8 pr-3 py-2 rounded-xl bg-white border border-emerald-100 outline-none text-emerald-700 text-xs" placeholder="Facebook ID">
                        </div>
                        <button onclick="toggleEditorPlatform('fb')" id="btn-fb" class="w-8 h-8 flex items-center justify-center bg-white rounded-xl border border-emerald-100 text-emerald-400 hover:bg-emerald-50 transition">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>
                <div class="flex gap-2">
                    <button onclick="togglePanel('socialsEditPanel')" class="w-1/3 bg-emerald-100 text-emerald-600 py-2 rounded-xl text-xs font-bold">Cancel</button>
                    <button onclick="saveSocials()" class="w-2/3 bg-emerald-500 text-white py-2 rounded-xl text-xs font-bold shadow-md">Save Changes</button>
                </div>
            </div>

            <!-- Image Cropper Modal -->
            <div id="cropperModal" class="fixed inset-0 bg-black/80 z-[1100] hidden flex flex-col items-center justify-center p-4">
                <div class="bg-white rounded-[2rem] w-full max-w-xs h-[60vh] flex flex-col shadow-2xl relative overflow-hidden">
                    <div class="px-5 py-3 border-b border-gray-100 flex-shrink-0 bg-white z-10 text-center">
                        <h3 class="text-emerald-600 font-bold text-sm">Adjust Photo</h3>
                    </div>
                    <div class="flex-1 bg-gray-50 relative w-full min-h-0 overflow-hidden p-6 flex items-center justify-center touch-none">
                        <img id="imageToCrop" src="" class="max-w-full max-h-full block object-contain" crossorigin="anonymous">
                    </div>
                    <div class="p-3 border-t border-gray-100 bg-white flex-shrink-0 z-10 flex gap-2">
                        <button onclick="cancelCrop()" class="flex-1 py-2 rounded-xl bg-gray-100 text-gray-500 font-bold text-xs hover:bg-gray-200 transition">Skip</button>
                        <button onclick="performCrop()" class="flex-1 py-2 bg-emerald-500 text-white rounded-xl font-bold text-xs shadow-md shadow-emerald-200 hover:scale-[1.02] transition">Save</button>
                    </div>
                </div>
            </div>

            <input type="file" id="updateProfilePicInput" accept="image/*" class="hidden">
        </div>
    </div>
